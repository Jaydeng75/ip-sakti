POSTGRES_PASSWORD=replace-with-a-strong-database-password
IPSAKTI_SECRET_KEY=replace-with-at-least-32-random-characters
# Accept both AI4Bharat IndicTrans2 gated model terms, then provide a read-only Hugging Face token.
HF_TOKEN=hf_replace_with_read_token
# Pin reviewed model commit hashes before production deployment; main is convenient for local evaluation only.
INDICTRANS_EN_INDIC_REVISION=173b94239f7c38886b2747b8d4a5db771a7e1232
INDICTRANS_INDIC_EN_REVISION=eb9e49d81077cfc5311e82ff36d8c1fc11557b5d
# CPU-friendly local default; accelerator deployments can raise this to 5.
INDICTRANS_GENERATION_BEAMS=1
# Set true on a memory-sized demo/production host to remove first-request model loading.
INDICTRANS_PRELOAD_MODELS=false
TRANSLATION_SERVICE_TOKEN=replace-with-a-random-internal-service-token
# Neural retrieval service. Use the same internal token for backend-to-service authentication.
RETRIEVAL_SERVICE_TOKEN=replace-with-a-random-internal-service-token
RETRIEVAL_PRELOAD_MODELS=true
IPSAKTI_RERANKER_ALLOW_FALLBACK=false
# Optional guarded reasoning layer. Cloudflare Workers Free stops at its daily
# allocation instead of billing overages; keep the token server-side only.
IPSAKTI_LLM_ENABLED=false
IPSAKTI_LLM_PROVIDER=cloudflare
IPSAKTI_LLM_ACCOUNT_ID=
IPSAKTI_LLM_API_KEY=
IPSAKTI_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
IPSAKTI_LLM_ALLOW_FALLBACK=true
# Live research: PubMed works without a key at public limits; identify the tool with a contact email.
IPSAKTI_NCBI_CONTACT_EMAIL=team@example.org
IPSAKTI_NCBI_API_KEY=
# Register an EPO OPS application. Without these, the app displays credential-required and asserts no claim result.
IPSAKTI_EPO_OPS_CONSUMER_KEY=
IPSAKTI_EPO_OPS_CONSUMER_SECRET=
