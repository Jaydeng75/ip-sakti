IPSAKTI_ENVIRONMENT=development
IPSAKTI_SECRET_KEY=replace-with-at-least-32-random-characters
IPSAKTI_DATABASE_URL=sqlite:///./data/ip_sakti.db
IPSAKTI_ALLOWED_ORIGINS=http://localhost:3000
IPSAKTI_DEMO_MODE=true
IPSAKTI_ACCESS_TOKEN_MINUTES=60
IPSAKTI_MAX_UPLOAD_BYTES=10485760
IPSAKTI_TRANSLATION_ENABLED=false
IPSAKTI_TRANSLATION_URL=http://localhost:8100
IPSAKTI_TRANSLATION_TIMEOUT_SECONDS=120
# IPSAKTI_BOOTSTRAP_ADMIN_EMAIL=admin@example.gov.in
# IPSAKTI_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-secret
