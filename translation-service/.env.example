INDICTRANS_HF_TOKEN=hf_replace_with_read_token
INDICTRANS_EN_INDIC_MODEL=ai4bharat/indictrans2-en-indic-dist-200M
INDICTRANS_INDIC_EN_MODEL=ai4bharat/indictrans2-indic-en-dist-200M
